{
  "name": "pool-water-test-strips",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npx concurrently \"npm run dev\" \"npm run pretty:watch\"",
    "dev": "vite --host",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "pretty": "npx prettier --config .prettierrc -w \"./**/*.*{ts,tsx,vue,css}\"",
    "pretty:watch": "npx onchange \"./**/*.*{ts,tsx,vue,css}\" -- prettier --config .prettierrc -w --ignore-unknown {{changed}}"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.2.1",
    "onchange": "^7.1.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vue-tsc": "^3.1.5"
  }
}
